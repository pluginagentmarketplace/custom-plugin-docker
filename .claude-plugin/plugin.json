    "docker",
    "containers",
    "dockerfile",
    "docker-compose",
    "images",
    "volumes",
    "networks",
    "orchestration",
    "devops",
    "containerization"
  ],
  "agents": [
    "./agents/01-docker-fundamentals.md",
    "./agents/02-docker-images.md",
