{
  "name": "docker-development-assistant",
  "version": "2.0.0",
  "description": "Comprehensive Docker development plugin with 8 specialized agents and 12 skills covering containers, images, Dockerfile, Docker Compose, networking, security, and production deployment - inspired by roadmap.sh",
  "author": {
    "name": "Dr. Umit Kacar & Muhsin Elcicek",
    "email": "kacarumit.phd@gmail.com"
  },
