  "skills": [
    "./skills/docker-installation/SKILL.md",
    "./skills/docker-images/SKILL.md",
    "./skills/docker-containers/SKILL.md",
    "./skills/docker-volumes/SKILL.md",
    "./skills/docker-networks/SKILL.md",
    "./skills/docker-dockerfile/SKILL.md",
    "./skills/docker-compose/SKILL.md",
    "./skills/docker-registries/SKILL.md",
    "./skills/docker-security/SKILL.md",
    "./skills/docker-cli/SKILL.md",
    "./skills/docker-devex/SKILL.md",
    "./skills/docker-orchestration/SKILL.md"
  ],
  "commands": [
    "./commands/docker-check.md",
    "./commands/docker-build.md",
    "./commands/docker-compose-up.md",
    "./commands/docker-debug.md"
  ],
  "hooks": "./hooks/hooks.json"
}